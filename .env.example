# Environment & secrets
# API key for authentication (leave empty to disable auth)
API_KEY=

# Rate limiting
# Maximum requests per client IP within the time window
RATE_LIMIT_MAX=120
# Time window in seconds
RATE_LIMIT_WINDOW=60

# CORS
# Comma-separated list of allowed origins (leave empty to disable CORS)
# Example: http://localhost:3000,https://app.example.com
CORS_ORIGINS=

# Request limits
# Maximum request body size in bytes (default: 16 KB)
MAX_REQUEST_SIZE=16384
